{
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "for f in \"$HOME/.claude/hooks/careful-guard.sh\" /home/user/claude-skills/scripts/careful-guard.sh \"$HOME/claude-skills/scripts/careful-guard.sh\" \"$HOME/.claude-skills-repo/scripts/careful-guard.sh\"; do [ -f \"$f\" ] && exec bash \"$f\"; done; exit 0"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      },
      "autoUpdate": true
    }
  },
  "askUserQuestionTimeout": "never",
  "theme": "dark",
  "autoContinueAtUsageLimit": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "promptSuggestionEnabled": true,
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000",
    "CLAUDE_CODE_RETRY_WATCHDOG": "1",
    "CLAUDE_CODE_RETRY_WATCHDOG_USAGE_LIMIT_RECHECK_MS": "300000"
  },
  "syncClaudeAiPlugins": false,
  "deniedMcpServers": [
    {
      "serverName": "Booking.com"
    },
    {
      "serverName": "claude.ai Booking.com"
    },
    {
      "serverName": "eDreams"
    },
    {
      "serverName": "claude.ai eDreams"
    },
    {
      "serverName": "Gmail"
    },
    {
      "serverName": "claude.ai Gmail"
    },
    {
      "serverName": "Google Compute Engine"
    },
    {
      "serverName": "claude.ai Google Compute Engine"
    },
    {
      "serverName": "Postman"
    },
    {
      "serverName": "claude.ai Postman"
    },
    {
      "serverName": "Cloudflare Developer Platform"
    },
    {
      "serverName": "claude.ai Cloudflare Developer Platform"
    }
  ]
}
